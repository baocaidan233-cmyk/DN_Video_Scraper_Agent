      "id": "694edaab-391d-4708-9753-984eae1c89e6"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Find the first item where check_get is null\nconst targetItem = items.find(item => item.json.check_get === null);\n\nif (targetItem) {\n  return [ targetItem.json ];  // Return as array of json\n} else {\n  return [];  // No matching item found\n}"
      },
