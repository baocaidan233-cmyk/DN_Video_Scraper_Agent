      "parameters": {
        "jsCode": "// ---------- Simple media detector ----------\nfor (const item of $input.all()) {\n  const url = item.json.media_url || '';\n  // Strip query‐string & fragment, then get the last path segment\n  const cleanPath = url.split(/[?#]/)[0];\n  // To handle URLs ending with '/', filter out empty segments before pop\n  const filenamePart = cleanPath.split('/').filter(Boolean).pop() || '';\n  const extMatch = filenamePart.match(/\\.([a-z0-9]+)$/i);\n  const ext = extMatch ? extMatch[1].toLowerCase() : '';\n\n  // Minimal MIME map\n  const mimeMap = {\n    jpg:  'image/jpeg',\n    jpeg: 'image/jpeg',\n    png:  'image/png',\n    gif:  'image/gif',\n    webp: 'image/webp',\n    svg:  'image/svg+xml',\n    bmp:  'image/bmp',\n    tiff: 'image/tiff',\n    avif: 'image/avif',\n    mp4:  'video/mp4',\n    mov:  'video/quicktime',\n    avi:  'video/x-msvideo',\n    mts:  'video/x-msvideo',\n    webm: 'video/webm',\n    mkv:  'video/x-matroska',\n    m4v:  'video/x-m4v',\n    ts:   'video/MP2T'\n  };\n\n  // Detect content-type; fallback rules keep it simple\n  let contentType = mimeMap[ext];\n  if (!contentType) {\n    // crude fallback: check for video clues in URL path or query string\n    const isVideo = /\\/video\\//.test(cleanPath) ||\n                    /[?&]mime_type=video/i.test(url) ||\n                    /\\.(mp4|mov|avi|webm|mkv|flv|wmv|3gp|m4v|ts|mts)(\\?|#|$)/i.test(url);\n\n    contentType = isVideo ? 'video/mp4' : 'application/octet-stream';\n  }\n\n  const mediaType = contentType.startsWith('video/') ? 'video' : 'image';\n  const tmpExt    = ext || (mediaType === 'video' ? 'mp4' : 'jpg');\n  const tmpName   = `tempname.${tmpExt}`;\n\n  // Write results back\n  item.json.detected_content_type = contentType;\n  item.json.media_type            = mediaType;\n  item.json.detected_filename     = tmpName;\n}\n\nreturn $input.all(); "
      },
      "type": "n8n-nodes-base.code",
