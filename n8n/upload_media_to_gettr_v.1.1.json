    {
      "parameters": {
        "jsCode": "// Loop over input items to process the HTTP response.\nfor (const item of $input.all()) {\n  // Check for a successful status code and the existence of a body.\n  if (item.json.statusCode === 200 && item.json.body) {\n    // Use destructuring to separate the body from the rest of the properties.\n    const { body, ...rest } = item.json;\n    // Create a new item.json by merging the rest of the properties with the content of the body.\n    item.json = { ...rest, ...body };\n  } else {\n    // If the request was not successful or the body is empty, create a consistent structure.\n    item.json.media_type = null;\n    item.json.width = null;\n    item.json.height = null;\n    // And ensure the body property is removed.\n    delete item.json.body;\n  }\n}\n\n// Return the modified items.\nreturn $input.all();"
      },
