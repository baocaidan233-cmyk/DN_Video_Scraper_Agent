    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of items) {\n  const mediaList = item.json.media || [];\n\n  mediaList.forEach((media, index) => {\n    results.push({\n      json: {\n        originalId: item.json.notion_page_id,\n        mediaUrl: media,\n        name: item.json.name,\n        seq: index,\n        post_content: item.json.post_content,\n        url: item.json.url\n      }\n    });\n  });\n}\n\nreturn results;"
