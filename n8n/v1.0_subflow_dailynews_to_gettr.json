    {
      "parameters": {
        "jsCode": "/*\n  n8n Code node\n  detect video elements\n  Fix: media array里第一个不一定是video类型\n  Fix: 处理所有输入items而不只是第一个\n*/\n\nconst items = $input.all();\n\nreturn items.map(item => {\n  const { post_content, media } = item.json;\n\n  // Find the first video element in media array (identified by having m3u8 property)\n  const videoIndex = media?.findIndex(item => item.m3u8) ?? -1;\n  const videoElement = videoIndex >= 0 ? media[videoIndex] : null;\n  const imgs = media?.length > 0 ? media.filter(item => !item.m3u8).map(item => item.screen || item.ori) : [];\n  \n  const postData = {\n    data: {\n      _t: \"post\",\n      acl: { _t: \"acl\" },\n      txt: `${post_content}`.trim(),\n      udate: Date.now(),\n      cdate: Date.now(),\n      uid: $('config').first().json.pub_post_author_id,\n      // Only include images (non-video items) in imgs array\n      imgs: imgs,\n      // Use video element metadata if video exists, otherwise use first media element or null\n      // image width and height needed when only one image attached in this post    \n      main: videoElement ? (videoElement.screen || videoElement.ori) : (media?.[0]?.screen || media?.[0]?.ori || null),\n      vid: videoElement?.m3u8 || null,\n      ovid: videoElement?.nm_uri || null,\n      pvid: videoElement?.m3u8 || null,\n      nmvid: videoElement?.nm_uri || null,\n      vid_dur: videoElement?.duration || null,\n      vid_wid: videoElement?.width || (imgs?.length === 1 ? media?.[0].im_width : null) || null,\n      vid_hgt: videoElement?.height || (imgs?.length === 1 ? media?.[0]?.im_height : null) || null\n    },\n    aux: null,\n    serial: \"post\"\n  };\n\n  const auth = {\n    user: $(\"config\").first().json.pub_post_author_id, \n    token: $('config').first().json.pub_post_author_token\n  };\n\n  return { \n    gettr_post_data: JSON.stringify(postData),\n    gettr_post_auth: JSON.stringify(auth) \n  };\n});"
      },
