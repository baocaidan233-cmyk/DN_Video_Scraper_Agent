    {
      "parameters": {
        "functionCode": "const crypto = require('crypto');\n\nfor (const item of items) {\n  let postContent = item.json.post_content || '';\n  const mediaUrl = Array.isArray(item.json.media) && item.json.media.length > 0\n    ? item.json.media[0]\n    : '';\n\n  // 1. 文本裁剪 (limit to 500 characters for simplicity)\n  postContent = postContent.substring(0, 500);\n\n  // 2. 去掉URL参数再拼接\n  let cleanMediaUrl = '';\n  if (mediaUrl) {\n    // Remove URL parameters (everything after ?)\n    cleanMediaUrl = mediaUrl.split('?')[0];\n  }\n\n  const combinedContent = `${postContent}${cleanMediaUrl}`.trim();\n\n  if (combinedContent) {\n    // 3. 用最简单的方法计算hash - 直接对原始内容计算\n    const hash = crypto.createHash('sha1').update(combinedContent).digest('hex').slice(0, 12);\n    item.json.hash = hash;\n  } else {\n    item.json.hash = null;\n  }\n}\n\nreturn items;"
      },
