    {
      "parameters": {
        "jsCode": "// Fix N8N JS code to process all input items and return same number of outputs\nconst items = $input.all();\n\n// Process each item and return array with same length\nreturn items.map(item => {\n  const { post_content, prev_desc, prev_img, prev_src_link, prev_ttl } = item.json;\n\n  const postData = {\n    data: {\n      _t: \"post\",\n      acl: { _t: \"acl\" },\n      txt: post_content,\n      dsc: prev_desc,\n      previmg: prev_img,\n      prevsrc: prev_src_link,\n      ttl: prev_ttl,\n      udate: Date.now(),\n      cdate: Date.now(),\n      uid: $('config').first().json.pub_post_author_id\n    },\n    aux: null,\n    serial: \"post\"\n  };\n\n  const auth = {\n    user: $(\"config\").first().json.pub_post_author_id, \n    token: $('config').first().json.pub_post_author_token\n  };\n\n  return { \n    gettr_post_data: JSON.stringify(postData),\n    gettr_post_auth: JSON.stringify(auth) \n  };\n}); "
      },
