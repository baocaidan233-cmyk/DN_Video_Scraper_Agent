    },
    {
      "parameters": {
        "jsCode": "const aggregated = {};\nconst uploadResults = $input.all();\nconst mediaListItems = $items(\"get media list\");\n\n// The `upload media` node is in \"each\" mode, so the output items correspond by index\n// to the input items from \"get media list\". We can correlate them by index.\n\nfor (const [index, uploadResultItem] of uploadResults.entries()) {\n  // Find the corresponding item from the node that produced `originalId`.\n  const sourceItem = mediaListItems[index];\n\n  if (!sourceItem) {\n    // Should not happen if item counts match\n    continue;\n  }\n\n  const json = sourceItem.json;\n  const originalId = json.originalId;\n\n  if (!originalId) {\n    continue;\n  }\n\n  if (!aggregated[originalId]) {\n    aggregated[originalId] = {\n      post_content: json.post_content,\n      url: json.url,\n      media: []\n    };\n  }\n\n  // The result from the upload is in `uploadResultItem.json`\n  const uploadJson = uploadResultItem.json;\n\n  if (uploadJson?.media_info?.ori) {\n    aggregated[originalId].media.push({      \n      ...uploadJson.media_info,\n      seq: json.seq // seq comes from the source item\n    });\n  }\n}\n\nconst resultItems = [];\nfor (const id in aggregated) {\n  const post = aggregated[id];\n  post.media.sort((a, b) => a.seq - b.seq);\n  resultItems.push({\n    json: {\n      originalId: id,\n      post_content: post.post_content,\n      url: post.url,\n      media: post.media\n    }\n  });\n}\n\nreturn resultItems;"
      },
